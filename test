3️⃣ UDP Receiver (localhost)

Listens for NMEA sentences and parses DPT messages.

import java.net.DatagramPacket;
import java.net.DatagramSocket;
import java.nio.charset.StandardCharsets;

public class NmeaUdpReceiver {

    public static void main(String[] args) {

        int port = 10110;

        try (DatagramSocket socket = new DatagramSocket(port)) {
            System.out.println("Listening for NMEA on UDP port " + port);

            byte[] buffer = new byte[1024];

            while (true) {
                DatagramPacket packet = new DatagramPacket(buffer, buffer.length);
                socket.receive(packet);

                String received = new String(
                        packet.getData(),
                        0,
                        packet.getLength(),
                        StandardCharsets.US_ASCII
                );

                for (String line : received.split("\r\n")) {
                    try {
                        if (line.contains("DPT")) {
                            DptMessage dpt = DptParser.parse(line);
                            System.out.println("Received: " + dpt);
                        }
                    } catch (Exception e) {
                        System.err.println("Invalid sentence: " + line);
                    }
                }
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}


