1️⃣ NMEA DPT Model (POJO)

public class DptMessage {

    private final String talkerId;   // e.g. SD
    private final double depthMeters;
    private final double offsetMeters;

    public DptMessage(String talkerId, double depthMeters, double offsetMeters) {
        this.talkerId = talkerId;
        this.depthMeters = depthMeters;
        this.offsetMeters = offsetMeters;
    }

    public String getTalkerId() {
        return talkerId;
    }

    public double getDepthMeters() {
        return depthMeters;
    }

    public double getOffsetMeters() {
        return offsetMeters;
    }

    @Override
    public String toString() {
        return "DptMessage{" +
                "talkerId='" + talkerId + '\'' +
                ", depthMeters=" + depthMeters +
                ", offsetMeters=" + offsetMeters +
                '}';
    }
}


