2️⃣ NMEA DPT Parser

Validates checksum and converts sentence → model.

public class DptParser {

    public static DptMessage parse(String nmea) {

        nmea = nmea.trim();

        if (!nmea.startsWith("$") || !nmea.contains("*")) {
            throw new IllegalArgumentException("Invalid NMEA format");
        }

        String[] parts = nmea.substring(1).split("\\*");
        String body = parts[0];
        String checksum = parts[1];

        if (!checksum.equalsIgnoreCase(calculateChecksum(body))) {
            throw new IllegalArgumentException("Checksum mismatch");
        }

        String[] fields = body.split(",");

        // Example: SDDPT,12.3,0.0
        if (!fields[0].endsWith("DPT")) {
            throw new IllegalArgumentException("Not a DPT sentence");
        }

        String talkerId = fields[0].substring(0, 2);
        double depth = Double.parseDouble(fields[1]);
        double offset = Double.parseDouble(fields[2]);

        return new DptMessage(talkerId, depth, offset);
    }

    private static String calculateChecksum(String sentence) {
        int checksum = 0;
        for (char c : sentence.toCharArray()) {
            checksum ^= c;
        }
        return String.format("%02X", checksum);
    }
}


